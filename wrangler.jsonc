{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payhub",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
"compatibility_flags": [
  "nodejs_compat"
],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payhub",
      "database_id": "82e392a2-1c38-4b20-a25f-6e2223c5f5dd"
    }
  ]
}
